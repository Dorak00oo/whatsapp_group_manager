# Postgres (Coolify homelab o cualquier host).
#
# PRODUCCIÓN (app en Coolify): usa el hostname interno del contenedor Postgres
#   postgres://USER:PASSWORD@q13zchw31hbghgoglyd1a7eq:5432/wspdb
#
# DESARROLLO LOCAL: Postgres en LAN (Coolify → Public Port 5433 → contenedor 5432)
#   DATABASE_URL="postgres://USER:PASSWORD@192.168.40.50:5433/wspdb"
# Sin túnel SSH: npm run dev conecta directo si estás en la misma red.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB"

# Opcional: solo para scripts/túnel (no commitear contraseñas reales; usa .env.local)
# HOMELAB_SSH_HOST="192.168.40.50"
# HOMELAB_SSH_USER="drk000"

# Secreto para firmar sesiones (generar: openssl rand -base64 32)
AUTH_SECRET=""

# Pon AUTH_DEBUG=1 para ver en consola del servidor por qué falla el login (quítalo después)
# AUTH_DEBUG="1"

# Única cuenta comunitaria (no hay registro público)
COMMUNITY_EMAIL="comunidad@ejemplo.local"
COMMUNITY_PASSWORD="cambia-esta-contraseña"
# Opcional: nombre que verás en el panel
# COMMUNITY_DISPLAY_NAME="Comunidad"

# Si `npm run dev` usa otro puerto (ej. 3001), define el origen exacto:
# AUTH_URL="http://localhost:3001"

# Producción: URL pública canónica (HTTPS). Si queda un dominio viejo aquí,
# Auth.js puede redirigir el login a esa URL. En Coolify: AUTH_URL=https://wsp.drk000.dev
# AUTH_URL="https://tu-dominio.vercel.app"

# --- Bot WhatsApp (Yuki / x:\WspBot) ---
# Misma clave en el .env del bot. POST /api/wsp-bot (altas/bajas del grupo)
WSP_BOT_API_KEY=""
# Consola QR/logs. Misma URL en Coolify y en npm run dev:
WSP_BOT_CONTROL_URL="https://bot.drk000.dev"
#
# Prender/Apagar: API de Coolify. No uses COOLIFY_URL: Coolify la pisa con la URL del panel.
# En Coolify (producción):
# WSP_COOLIFY_API_URL="http://coolify:8080"
# En npm run dev:
# WSP_COOLIFY_API_URL="https://coolify.drk000.dev"
# COOLIFY_TOKEN=""
# WSP_BOT_COOLIFY_UUID="mvy2lvxiqv4l0xygym3xudup"
#
# Solo si desarrollás el bot en este PC (sin Coolify):
# WSP_BOT_CONTROL_URL="http://127.0.0.1:3010"
# WSP_BOT_ROOT="X:\\WspBot"

# --- API de Minecraft: recibe datos del addon ---
# Clave secreta para autenticar peticiones del servidor de Minecraft
# Genera una: openssl rand -base64 32
MINECRAFT_API_KEY=""
